# Copiá este archivo como ".env" y completalo. El ".env" NO se sube al repositorio.

PORT=3000

# --- Base de datos ---
# Local (XAMPP / MySQL instalado):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peluqueria

# Aiven (consola de Aiven → tu servicio MySQL → Overview → Connection information):
# DB_HOST=mysql-xxxx.aivencloud.com
# DB_PORT=12345            # el puerto "MySQL", no el de X Protocol
# DB_USER=avnadmin
# DB_PASSWORD=la_contraseña_de_aiven
# DB_NAME=defaultdb
# DB_SSL=true
# DB_SSL_CA_FILE=./ca.pem  # en tu PC: ruta al certificado descargado de Aiven
# DB_SSL_CA=               # en Vercel: pegá el contenido completo del ca.pem acá
# DB_POOL_SIZE=3           # en Vercel, un número bajo

# --- Firebase / CORS ---
FIREBASE_PROJECT_ID=peluqueria-maty-alan
CORS_ORIGINS=http://localhost:4200,https://peluqueria-maty-alan.web.app,https://peluqueria-maty-alan.firebaseapp.com
