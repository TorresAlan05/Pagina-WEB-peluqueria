rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Perfil de usuario.
    //  - Cada uno lee el suyo, el admin lee todos y cualquier usuario con sesión puede ver a los peluqueros.
    //  - Al registrarse solo se puede crear como 'cliente'.
    //  - ÚNICO ADMIN: solo el admin cambia roles, solo a 'cliente' o 'peluquero', y nadie puede tocar al admin.
    match /users/{uid} {
      allow read: if signedIn()
                  && (request.auth.uid == uid || isAdmin() || resource.data.role == 'peluquero');

      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'cliente'
                    && request.resource.data.keys().hasOnly(['email', 'role', 'nombre', 'apellido', 'creadoEn'])
                    && request.resource.data.get('nombre', '').size() <= 60
                    && request.resource.data.get('apellido', '').size() <= 60;

      allow update: if isAdmin()
                    && resource.data.role != 'admin'
                    && request.resource.data.role in ['cliente', 'peluquero']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);

      allow delete: if isAdmin() && resource.data.role != 'admin';
    }

    // Turnos (reglas heredadas de cuando se guardaban en Firestore; hoy van por la API)
    match /turnos/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.mail == request.auth.token.email
                    && request.resource.data.estado == 'Pendiente';

      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.estado == resource.data.estado
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.mail == resource.data.mail);

      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /ocupados/{slot} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && slot == request.resource.data.dia + '_' + request.resource.data.hora;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}